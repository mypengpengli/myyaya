<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
  <uses-feature android:glEsVersion="0x00020000" android:required="false" />
  <queries>
    <package android:name="com.google.ar.core" />
    <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="market" /></intent>
    <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
  </queries>
  <application>
    <provider android:name=".ReferencePhotoProvider"
      android:authorities="${applicationId}.myyaya.reference-photo"
      android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/myyaya_reference_photo_paths" />
    </provider>
    <meta-data android:name="com.google.ar.core" android:value="optional" />
    <activity android:name=".NavigationProbeActivity"
      android:exported="false"
      android:screenOrientation="landscape"
      android:configChanges="orientation|screenSize|keyboardHidden"
      android:theme="@android:style/Theme.Material.NoActionBar" />
  </application>
</manifest>
